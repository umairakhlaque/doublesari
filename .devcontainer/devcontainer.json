{
  "name": "Double Sar",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // Forward backend (3001) and frontend dev server (5173)
  "forwardPorts": [3001, 5173],
  "portsAttributes": {
    "3001": {
      "label": "Backend API",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  "postCreateCommand": "npm run install:all",

  // In Codespaces the forwarded URL looks like:
  //   https://<codespace-name>-3001.app.github.dev
  // We inject that as CLIENT_URL and VITE_SERVER_URL via the startup script.
  "postStartCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
